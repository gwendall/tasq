{
  "name": "tasq-monorepo",
  "version": "0.0.0-private",
  "private": true,
  "description": "Local-first task tracking that humans and AI agents share without stepping on each other.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22"
  },
  "scripts": {
    "agent:preflight": "bun scripts/agent-preflight.ts",
    "adoption:validate": "bun scripts/validate-tq606-human-evidence.ts",
    "dogfood": "bun scripts/dogfood.ts",
    "verify:quick": "bun scripts/verify-handoff.ts --quick",
    "verify:handoff": "bun scripts/verify-handoff.ts",
    "docs:check": "bun test packages/tasq-evals/documentation-contract.test.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --workspace-concurrency=1 -r --if-present test",
    "build:site": "pnpm --filter @tasq-internal/site build",
    "test:site:browser": "pnpm --filter @tasq-internal/site test:browser",
    "build:cli": "bun packages/tasq-cli/scripts/build.ts --outdir dist/cli",
    "certify:agents": "bun scripts/run-zero-context-agent-certification.ts",
    "build:packages": "bun scripts/release/build-public-packages.ts",
    "verify:export": "bun test packages/tasq-cli/test/public-packages.test.ts packages/tasq-cli/test/extension-boundary.test.ts",
    "verify:live": "bun scripts/verify-live-site.ts",
    "backlog:project": "bun scripts/backlog-from-ledger.ts",
    "typecheck:tests": "bun scripts/verify-typecheck-tests.ts"
  },
  "devDependencies": {
    "@tasq-run/schema": "workspace:*",
    "playwright": "1.62.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.11",
      "fast-uri": "3.1.5",
      "hono": "4.13.3",
      "ip-address": "10.5.0",
      "postcss": "8.5.26",
      "sharp": "0.35.3"
    }
  }
}
