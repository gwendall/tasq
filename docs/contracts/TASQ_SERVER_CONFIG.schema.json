{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasq.run/schemas/server-config-v1.json",
  "title": "Tasq Server configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "publicUrl",
    "listen",
    "authorityDatabaseUrl",
    "hostTenantId",
    "enrollment",
    "jwt",
    "additionalJwtIssuers",
    "workspaces",
    "support"
  ],
  "properties": {
    "contractVersion": { "const": "tasq.server-config.v1" },
    "publicUrl": { "type": "string", "format": "uri", "pattern": "^https://[^?#]+/$" },
    "listen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "trustTlsProxy"],
      "properties": {
        "host": { "type": "string", "minLength": 1, "maxLength": 255 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "trustTlsProxy": { "type": "boolean" }
      }
    },
    "authorityDatabaseUrl": { "$ref": "#/$defs/fileDatabaseUrl" },
    "hostTenantId": { "$ref": "#/$defs/id" },
    "enrollment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "accessLifetimeMs"],
      "properties": {
        "issuer": { "type": "string", "format": "uri", "pattern": "^https://" },
        "accessLifetimeMs": { "type": "integer", "minimum": 60000, "maximum": 31536000000 }
      }
    },
    "jwt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "audience", "keys", "scopeActions", "clockSkewMs"],
      "properties": {
        "issuer": { "type": "string", "format": "uri", "pattern": "^https://" },
        "audience": { "type": "string", "format": "uri", "pattern": "^https://" },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kid", "jwk"],
            "properties": {
              "kid": { "$ref": "#/$defs/id" },
              "jwk": {
                "type": "object",
                "required": ["kty", "n", "e"],
                "properties": {
                  "kty": { "const": "RSA" },
                  "n": { "type": "string", "minLength": 1 },
                  "e": { "type": "string", "minLength": 1 },
                  "alg": { "const": "RS256" },
                  "use": { "const": "sig" },
                  "kid": { "type": "string" }
                }
              }
            }
          }
        },
        "scopeActions": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "enum": ["reader", "coordinator"] },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": { "$ref": "#/$defs/actionIdentity" }
              }
            ]
          }
        },
        "clockSkewMs": { "type": "integer", "minimum": 0, "maximum": 300000 }
      }
    },
    "additionalJwtIssuers": {
      "type": "array",
      "maxItems": 7,
      "items": { "$ref": "#/$defs/jwtIssuer" }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedTrustRootDigests"],
      "properties": {
        "acceptedTrustRootDigests": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "storageBindingId", "databaseUrl", "receiptDatabaseUrl"],
        "properties": {
          "id": { "$ref": "#/$defs/workspaceId" },
          "storageBindingId": { "$ref": "#/$defs/id" },
          "databaseUrl": { "$ref": "#/$defs/fileDatabaseUrl" },
          "receiptDatabaseUrl": { "$ref": "#/$defs/fileDatabaseUrl" }
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documentationUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "contact": { "type": "string", "format": "email" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 500 },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
    },
    "fileDatabaseUrl": { "type": "string", "pattern": "^file:/[^?#]+$" },
    "actionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "version", "implementationDigest"],
      "properties": {
        "uri": { "type": "string", "format": "uri" },
        "version": { "type": "integer", "minimum": 1 },
        "implementationDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "jwtIssuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "audience", "keys", "scopeActions", "clockSkewMs"],
      "properties": {
        "issuer": { "type": "string", "format": "uri", "pattern": "^https://" },
        "audience": { "type": "string", "format": "uri", "pattern": "^https://" },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["kid", "jwk"],
            "properties": {
              "kid": { "$ref": "#/$defs/id" },
              "jwk": {
                "type": "object",
                "required": ["kty", "n", "e"],
                "properties": {
                  "kty": { "const": "RSA" },
                  "n": { "type": "string" },
                  "e": { "type": "string" }
                }
              }
            }
          }
        },
        "scopeActions": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "enum": ["reader", "coordinator"] },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": { "$ref": "#/$defs/actionIdentity" }
              }
            ]
          }
        },
        "clockSkewMs": { "type": "integer", "minimum": 0, "maximum": 300000 }
      }
    }
  }
}
