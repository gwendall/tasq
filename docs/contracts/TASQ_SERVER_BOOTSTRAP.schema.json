{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasq.run/schemas/server-bootstrap-v1.json",
  "title": "Tasq Server initial authority bootstrap v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "hostTenantId", "createdAt", "workspaces"],
  "properties": {
    "contractVersion": { "const": "tasq.server-bootstrap.v1" },
    "hostTenantId": { "type": "string", "minLength": 1, "maxLength": 500 },
    "createdAt": { "type": "integer", "minimum": 0 },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "principals"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
          },
          "principals": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "issuer", "subject", "method", "role"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 500 },
                "kind": { "enum": ["human", "agent", "service", "runtime"] },
                "issuer": { "type": "string", "format": "uri", "pattern": "^https://" },
                "subject": { "type": "string", "minLength": 1, "maxLength": 500 },
                "method": {
                  "oneOf": [
                    { "enum": ["oidc", "oauth_introspection", "spiffe"] },
                    { "type": "string", "format": "uri" }
                  ]
                },
                "role": { "enum": ["reader", "coordinator"] }
              }
            }
          }
        }
      }
    }
  }
}
